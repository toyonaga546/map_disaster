{
  "name": "sakuchans-disaster-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite --env-file-if-exists=.env src/server.js",
    "dev": "node --experimental-sqlite --env-file-if-exists=.env --watch src/server.js",
    "test": "node --experimental-sqlite --test",
    "check:upload": "node scripts/check-upload.js",
    "check:firebase": "node --env-file-if-exists=.env scripts/check-firebase.js"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "firebase-admin": "14.5.0",
    "leaflet": "1.9.4",
    "sharp": "0.35.5"
  }
}
