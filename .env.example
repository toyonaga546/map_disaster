HOST=127.0.0.1
PORT=3000
# 公開環境ではHTTPSのURLに設定
APP_ORIGIN=http://localhost:3000
# Firestoreを使う場合はfirestoreに変更。未指定時はsqlite。
DB_DRIVER=sqlite
FIREBASE_PROJECT_ID=adv-ex2-map-diseater
# Cloud Storageを使う場合はfirebaseに変更。バケット名はgs://なしで指定。
STORAGE_DRIVER=local
FIREBASE_STORAGE_BUCKET=adv-ex2-map-diseater.firebasestorage.app
# サービスアカウントJSONを使う場合は、秘密鍵の絶対パスを指定。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/firebase-service-account.json
# 任意。未設定ならAIは判定不可。過去投稿画像のみ比較する。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
