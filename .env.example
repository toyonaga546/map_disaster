HOST=127.0.0.1
PORT=3000
# 公開環境ではHTTPSのURLに設定
APP_ORIGIN=http://localhost:3000
# Firestoreを使う場合はfirestoreに変更。未指定時はsqlite。
DB_DRIVER=sqlite
FIREBASE_PROJECT_ID=adv-ex2-map-diseater
# Cloud Storageを使う場合はfirebaseに変更。バケット名はgs://なしで指定。
STORAGE_DRIVER=local
FIREBASE_STORAGE_BUCKET=adv-ex2-map-diseater.firebasestorage.app
# サービスアカウントJSONを使う場合は、秘密鍵の絶対パスを指定。
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/firebase-service-account.json
# 任意。画像比較・危険度解析・同意された元画像のC2PA/SynthID検証に使用。
# 未設定や来歴検証APIの利用権限がない場合でも投稿でき、生成元は判定不可。
OPENAI_API_KEY=
# 任意。未設定ならストリートビュー画像は取得・保存されない。Street View Static APIを有効にし、サーバーのIPアドレスで制限したキーを使う。
GOOGLE_MAPS_API_KEY=
